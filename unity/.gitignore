# Unity standard ignores — commit only Assets/, ProjectSettings/, Packages/manifest.json
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should be committed; ignore only generated artifacts
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE
.idea/
.vs/
.vsconfig

# Crashlytics generated file
crashlytics-build.properties

# Exports / builds written by dev:unity land in the repo's public/unity/Build/, not here
/Build/

# Generated test results (edit-mode tests write here)
/TestResults/
